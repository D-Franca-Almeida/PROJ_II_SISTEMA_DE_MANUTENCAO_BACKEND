{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "AzureStorage": {
    "ContainerFotos": "uploads",
    "FilaEventos": "eventos-manutencao"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=cptm-manutencao.db"
  },
  "Prazos": {
    "Dias": 10,
    "ExecucaoAutomatica": true,
    "IntervaloMinutos": 1440
  },
  "Cors": {
    "Origens": [ "http://localhost:5173", "http://localhost:8081" ]
  },
  "AllowedHosts": "*"
}
